@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/saliasCoreTargets.cmake")
set(salias_core_FOUND TRUE)

set(salias_extras_FOUND FALSE)
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/saliasExtrasTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/saliasExtrasTargets.cmake")
  set(salias_extras_FOUND TRUE)
endif()

check_required_components(salias)
